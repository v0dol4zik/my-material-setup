" Lean Catppuccin Vim setup with no plugin dependency.
set background=dark
set termguicolors
set number
set relativenumber
set cursorline
set signcolumn=yes
set laststatus=2
set noshowmode
set mouse=a
set ignorecase
set smartcase
set incsearch
set hlsearch
set expandtab
set shiftwidth=4
set softtabstop=4
set tabstop=4

highlight Normal       guifg=#cdd6f4 guibg=#1e1e2e
highlight NormalNC     guifg=#bac2de guibg=#1e1e2e
highlight CursorLine                  guibg=#32302f
highlight LineNr       guifg=#45475a guibg=#1e1e2e
highlight CursorLineNr guifg=#f9e2af guibg=#32302f gui=bold
highlight Comment      guifg=#6c7086 gui=italic
highlight Constant     guifg=#cba6f7
highlight String       guifg=#a6e3a1
highlight Identifier   guifg=#89b4fa
highlight Statement    guifg=#f38ba8 gui=bold
highlight PreProc      guifg=#fab387
highlight Type         guifg=#f9e2af
highlight Special      guifg=#94e2d5
highlight Visual       guifg=#1e1e2e guibg=#89b4fa
highlight Search       guifg=#1e1e2e guibg=#f9e2af
highlight StatusLine   guifg=#1e1e2e guibg=#a6e3a1 gui=bold
highlight StatusLineNC guifg=#bac2de guibg=#313244
highlight VertSplit    guifg=#313244 guibg=#1e1e2e
highlight ErrorMsg     guifg=#f38ba8 guibg=#1e1e2e gui=bold
highlight Pmenu        guifg=#cdd6f4 guibg=#313244
highlight PmenuSel     guifg=#1e1e2e guibg=#a6e3a1 gui=bold
