" Lean Gruvbox-like Vim setup with no plugin dependency.
set background=dark
set termguicolors
set number
set relativenumber
set cursorline
set signcolumn=yes
set laststatus=2
set noshowmode
set mouse=a
set ignorecase
set smartcase
set incsearch
set hlsearch
set expandtab
set shiftwidth=4
set softtabstop=4
set tabstop=4

highlight Normal       guifg=#ebdbb2 guibg=#282828
highlight NormalNC     guifg=#d5c4a1 guibg=#282828
highlight CursorLine                  guibg=#32302f
highlight LineNr       guifg=#665c54 guibg=#282828
highlight CursorLineNr guifg=#fabd2f guibg=#32302f gui=bold
highlight Comment      guifg=#928374 gui=italic
highlight Constant     guifg=#d3869b
highlight String       guifg=#b8bb26
highlight Identifier   guifg=#83a598
highlight Statement    guifg=#fb4934 gui=bold
highlight PreProc      guifg=#fe8019
highlight Type         guifg=#fabd2f
highlight Special      guifg=#8ec07c
highlight Visual       guifg=#282828 guibg=#83a598
highlight Search       guifg=#282828 guibg=#fabd2f
highlight StatusLine   guifg=#282828 guibg=#b8bb26 gui=bold
highlight StatusLineNC guifg=#a89984 guibg=#3c3836
highlight VertSplit    guifg=#504945 guibg=#282828
highlight ErrorMsg     guifg=#fb4934 guibg=#282828 gui=bold
highlight Pmenu        guifg=#ebdbb2 guibg=#3c3836
highlight PmenuSel     guifg=#282828 guibg=#b8bb26 gui=bold
