    animations {
        workspace-switch {
            spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
        }
        // Material 2 motion: entering elements decelerate, leaving ones accelerate.
        window-open {
            duration-ms 225
            curve "cubic-bezier" 0.0 0.0 0.2 1.0
            // Grow from 90% while fading in, instead of niri's default zoom.
            custom-shader r"
                vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                    float scale = mix(0.9, 1.0, niri_clamped_progress);
                    vec3 coords = vec3((coords_geo.xy - 0.5) / scale + 0.5, 1.0);
                    if (coords.x < 0.0 || coords.x > 1.0 || coords.y < 0.0 || coords.y > 1.0)
                        return vec4(0.0);
                    vec3 coords_tex = niri_geo_to_tex * coords;
                    vec4 color = texture2D(niri_tex, coords_tex.st);
                    return color * niri_clamped_progress;
                }
            "
        }
        window-close {
            duration-ms 195
            curve "cubic-bezier" 0.4 0.0 1.0 1.0
        }
        horizontal-view-movement {
            spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
        }
        window-movement {
            spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
        }
        window-resize {
            spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
        }
        config-notification-open-close {
            spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
        }
        screenshot-ui-open {
            duration-ms 300
            curve "cubic-bezier" 0.4 0.0 0.2 1.0
        }
        overview-open-close {
            spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
        }
    }
