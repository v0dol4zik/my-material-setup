{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "CachyOS_small",
    "color": {
      "1": "green",
      "2": "green"
    },
    "padding": {
      "right": 2
    }
  },

  // Named ANSI colors: kitty maps them to the Noctalia terminal palette.
  "display": {
    "separator": "  ",
    "color": {
      "keys": "green",
      "title": "bright_green"
    }
  },

  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "packages",
    {
      "type": "disk",
      "format": "{size-used} / {size-total}"
    },
    "wm",
    "terminal",
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
