config_version = 14

[theme]
source = "custom"
custom_palette = "Material2-Green"
mode = "dark"
shell_mode = "follow"

    [theme.templates]
    builtin_ids = [ "btop", "cava", "gtk3", "gtk4", "kitty", "niri", "qt" ]
    community_ids = [ "discord", "zed" ]

[plugins]
enabled = [ "noctalia/bongocat" ]

[wallpaper.default]
path = "@CONFIG_HOME@/noctalia/wallpapers/material2-green.jpg"

[wallpaper.last]
path = "@CONFIG_HOME@/noctalia/wallpapers/material2-green.jpg"
